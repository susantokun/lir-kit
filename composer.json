{
    "name": "susantokun/lir-kit",
    "description": "Email-code (OTP) sign-in, sender email settings and templates, sidebar menu editor, users and roles, tamper-evident audit log, site settings and license for Laravel + Inertia + React. Pick the parts you need.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "inertia",
        "otp",
        "passwordless",
        "menu",
        "roles",
        "audit-log",
        "license"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/notifications": "^12.0|^13.0",
        "illuminate/mail": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "illuminate/auth": "^12.0|^13.0",
        "inertiajs/inertia-laravel": "^2.0|^3.0"
    },
    "suggest": {
        "ext-sodium": "Diperlukan hanya bila memakai License (memeriksa tanda tangan Ed25519).",
        "laravel/fortify": "Halaman auth starter memakai URL bawaan Fortify (login, lupa kata sandi, 2FA)."
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "orchestra/workbench": "^11.3",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Lir\\Kit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lir\\Kit\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lir\\Kit\\LirKitServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "pnpm exec concurrently -c \"#93c5fd,#fdba74\" --names=server,vite --kill-others \"composer serve\" \"pnpm dev\""
        ],
        "test": "@php vendor/bin/pest"
    }
}
